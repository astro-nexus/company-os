# ---------------------------------------------------------------------------
# CompanyOS — Firebase client configuration
# ---------------------------------------------------------------------------
# Copy this file to .env.local (gitignored). Vite only reads env files at
# startup, so restart `npm run dev` after any change.
#
# These belong to the EXISTING "CompanyOS" web app on Firebase project
# studio-8326696944-c3f9a. Do not create a new project or web app.
# Regenerate with:
#   firebase apps:sdkconfig WEB 1:534950805700:web:6f723477f929645c7fc991
#
# The data layer accepts either a VITE_ or a NEXT_PUBLIC_ prefix for every
# value, and vite.config.ts exposes both. VITE_ is the canonical form here.
#
# NOT SECRET: Firebase web config ships in every client bundle by design;
# Security Rules are the access boundary. A Firebase ADMIN service-account key
# is secret and must never appear here or anywhere under src/.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=AIzaSyDgMPkViBUYANIiZz8FH2kXwzSXf_TOvMk
VITE_FIREBASE_AUTH_DOMAIN=studio-8326696944-c3f9a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=studio-8326696944-c3f9a
VITE_FIREBASE_STORAGE_BUCKET=studio-8326696944-c3f9a.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=534950805700
VITE_FIREBASE_APP_ID=1:534950805700:web:6f723477f929645c7fc991

# IANA timezone defining a working day. MUST match COMPANY_TIMEZONE in the
# Cloud Functions environment.
VITE_COMPANY_TIMEZONE=Asia/Yangon

# Set to "true" to point the app at the local emulator suite instead of the
# live project. Requires `npm run emulators` in another terminal.
VITE_USE_EMULATORS=false
