{
  "name": "company-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CompanyOS — internal company operations platform for NexusCode",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "seed": "tsx scripts/seed.ts",
    "test:rules": "firebase emulators:exec --only firestore \"vitest run tests/rules.test.ts\"",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "test:e2e": "firebase emulators:exec --only auth,firestore,functions \"vitest run tests/e2e.test.ts\"",
    "seed:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 tsx scripts/seed.ts"
  },
  "dependencies": {
    "firebase": "^12.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-admin": "^13.6.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.0"
  }
}
